/* Project Settings page. Shared tokens live in ModelHub.uss. */

.ps {
    padding: 4px 14px 24px 10px;
    background-color: rgba(0, 0, 0, 0);
}

.ps-header {
    flex-direction: row;
    align-items: center;
}

.ps-intro {
    margin-top: 4px;
    margin-bottom: 4px;
    white-space: normal;
    color: var(--hf-text-muted);
}

.ps > .hf-section {
    margin-top: 22px;
}

.ps-location {
    flex-direction: row;
    margin: 0 0 8px 0;
}

.ps-location > RadioButton {
    margin-right: 16px;
}

.ps-custom {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.ps-custom > TextField {
    flex-grow: 1;
    flex-shrink: 1;
}

.ps-path {
    flex-direction: row;
    align-items: center;
}

.ps-path > .hf-kv__key {
    width: 70px;
}

.ps-path__value {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-right: 10px;
}

.ps-card-hint {
    margin-top: 8px;
    font-size: 11px;
    white-space: normal;
    color: var(--hf-text-muted);
}

.ps-footer {
    margin-top: 22px;
    font-size: 11px;
    white-space: normal;
    color: var(--hf-text-faint);
}
