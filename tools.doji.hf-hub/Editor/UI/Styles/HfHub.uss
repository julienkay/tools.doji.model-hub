/* Shared HF Hub editor styles: theme tokens and reusable components. */

.hf-dark {
    --hf-bg: #282828;
    --hf-surface: #303030;
    --hf-surface-raised: #383838;
    --hf-surface-hover: #3E3E3E;
    --hf-border: #1C1C1C;
    --hf-border-subtle: #3A3A3A;
    --hf-input: #232323;
    --hf-text: #DCDCDC;
    --hf-text-strong: #F2F2F2;
    --hf-text-muted: #9C9C9C;
    --hf-text-faint: #747474;
    --hf-link: #79AEFF;
    --hf-accent: #2F6FB8;
    --hf-accent-hover: #3B80CF;
    --hf-accent-text: #FFFFFF;
    --hf-selection: #2C5D87;
    --hf-selection-text: #FFFFFF;
    --hf-button: #474747;
    --hf-button-hover: #535353;
    --hf-button-border: #242424;
    --hf-success: #5BC27E;
    --hf-success-bg: rgba(91, 194, 126, 0.14);
    --hf-info: #6AA6F0;
    --hf-info-bg: rgba(106, 166, 240, 0.14);
    --hf-warning: #E6AF4B;
    --hf-warning-bg: rgba(230, 175, 75, 0.14);
    --hf-error: #EF6B5F;
    --hf-error-bg: rgba(239, 107, 95, 0.15);
    --hf-neutral: #A0A0A0;
    --hf-neutral-bg: rgba(160, 160, 160, 0.14);
    --hf-bar-cache: #4C8FD6;
    --hf-bar-project: #4FB477;
    --hf-bar-track: #222222;
    --hf-tile-used: #3E78B8;
    --hf-tile-used-text: #FFFFFF;
    --hf-tile-unused: #4A4A4A;
    --hf-tile-unused-text: #D4D4D4;
    --hf-tile-partial: #C9963F;
    --hf-tile-partial-text: #1C1C1C;
}

.hf-light {
    --hf-bg: #E2E2E2;
    --hf-surface: #EDEDED;
    --hf-surface-raised: #F7F7F7;
    --hf-surface-hover: #D9D9D9;
    --hf-border: #A9A9A9;
    --hf-border-subtle: #CACACA;
    --hf-input: #FFFFFF;
    --hf-text: #232323;
    --hf-text-strong: #0F0F0F;
    --hf-text-muted: #5A5A5A;
    --hf-text-faint: #808080;
    --hf-link: #1C5FC0;
    --hf-accent: #2E6DB6;
    --hf-accent-hover: #3A7CC8;
    --hf-accent-text: #FFFFFF;
    --hf-selection: #3A72B0;
    --hf-selection-text: #FFFFFF;
    --hf-button: #F3F3F3;
    --hf-button-hover: #FFFFFF;
    --hf-button-border: #A3A3A3;
    --hf-success: #23864A;
    --hf-success-bg: rgba(35, 134, 74, 0.12);
    --hf-info: #2563B4;
    --hf-info-bg: rgba(37, 99, 180, 0.11);
    --hf-warning: #A86A08;
    --hf-warning-bg: rgba(200, 130, 10, 0.14);
    --hf-error: #BE3326;
    --hf-error-bg: rgba(190, 51, 38, 0.11);
    --hf-neutral: #666666;
    --hf-neutral-bg: rgba(100, 100, 100, 0.12);
    --hf-bar-cache: #3E7FC6;
    --hf-bar-project: #2F9A5C;
    --hf-bar-track: #CFCFCF;
    --hf-tile-used: #4A86C8;
    --hf-tile-used-text: #FFFFFF;
    --hf-tile-unused: #BEBEBE;
    --hf-tile-unused-text: #1E1E1E;
    --hf-tile-partial: #E3A743;
    --hf-tile-partial-text: #1C1C1C;
}

.hf-root {
    flex-grow: 1;
    background-color: var(--hf-bg);
    color: var(--hf-text);
    font-size: 12px;
}

/* Text */

.hf-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--hf-text-strong);
}

.hf-heading {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--hf-text-strong);
}

.hf-overline {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--hf-text-muted);
    letter-spacing: 0.6px;
}

.hf-muted {
    color: var(--hf-text-muted);
}

.hf-faint {
    color: var(--hf-text-faint);
}

.hf-small {
    font-size: 11px;
}

.hf-wrap {
    white-space: normal;
}

.hf-ellipsis {
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 1;
}

/* Layout helpers */

.hf-row {
    flex-direction: row;
    align-items: center;
}

.hf-grow {
    flex-grow: 1;
    flex-shrink: 1;
}

.hf-spacer {
    flex-grow: 1;
}

.hf-hidden {
    display: none;
}

/* Buttons */

.hf-button {
    height: 24px;
    margin: 0 0 0 6px;
    padding: 0 12px;
    border-width: 1px;
    border-radius: 4px;
    border-color: var(--hf-button-border);
    background-color: var(--hf-button);
    color: var(--hf-text);
    -unity-font-style: normal;
    transition-duration: 0.12s;
}

.hf-button:hover {
    background-color: var(--hf-button-hover);
}

.hf-button:disabled {
    opacity: 0.5;
}

.hf-button--first {
    margin-left: 0;
}

.hf-button--primary {
    background-color: var(--hf-accent);
    border-color: var(--hf-accent);
    color: var(--hf-accent-text);
    -unity-font-style: bold;
}

.hf-button--primary:hover {
    background-color: var(--hf-accent-hover);
    border-color: var(--hf-accent-hover);
}

.hf-button--danger {
    color: var(--hf-error);
}

.hf-button--small {
    height: 20px;
    padding: 0 8px;
    font-size: 11px;
}

.hf-icon-button {
    width: 24px;
    height: 24px;
    margin: 0 0 0 2px;
    padding: 4px;
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
    transition-duration: 0.12s;
}

.hf-icon-button:hover {
    background-color: var(--hf-surface-hover);
}

.hf-icon-button > .hf-icon {
    width: 16px;
    height: 16px;
}

.hf-link {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--hf-link);
    -unity-text-align: middle-left;
}

.hf-link:hover {
    background-color: rgba(0, 0, 0, 0);
    color: var(--hf-text-strong);
}

/* Links row: Model card | Files | License */

.hf-links {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.hf-links > .hf-link {
    font-size: 11px;
}

.hf-links__separator {
    margin: 0 6px;
    padding: 0;
    font-size: 11px;
    color: var(--hf-text-faint);
}

/* Icons */

.hf-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.hf-icon--small {
    width: 12px;
    height: 12px;
}

/* Status pill */

.hf-pill {
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding: 0 8px;
    border-radius: 10px;
    flex-shrink: 0;
}

.hf-pill__dot {
    width: 7px;
    height: 7px;
    margin-right: 6px;
    border-radius: 4px;
}

.hf-pill__label {
    font-size: 11px;
    -unity-font-style: bold;
}

.hf-tone-success { background-color: var(--hf-success-bg); }
.hf-tone-success > .hf-pill__label { color: var(--hf-success); }
.hf-tone-success > .hf-pill__dot { background-color: var(--hf-success); }

.hf-tone-info { background-color: var(--hf-info-bg); }
.hf-tone-info > .hf-pill__label { color: var(--hf-info); }
.hf-tone-info > .hf-pill__dot { background-color: var(--hf-info); }

.hf-tone-warning { background-color: var(--hf-warning-bg); }
.hf-tone-warning > .hf-pill__label { color: var(--hf-warning); }
.hf-tone-warning > .hf-pill__dot { background-color: var(--hf-warning); }

.hf-tone-error { background-color: var(--hf-error-bg); }
.hf-tone-error > .hf-pill__label { color: var(--hf-error); }
.hf-tone-error > .hf-pill__dot { background-color: var(--hf-error); }

.hf-tone-neutral { background-color: var(--hf-neutral-bg); }
.hf-tone-neutral > .hf-pill__label { color: var(--hf-neutral); }
.hf-tone-neutral > .hf-pill__dot { background-color: var(--hf-neutral); }

/* Status dot used in lists */

.hf-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    flex-shrink: 0;
}

.hf-dot.hf-tone-success { background-color: var(--hf-success); }
.hf-dot.hf-tone-info { background-color: var(--hf-info); }
.hf-dot.hf-tone-warning { background-color: var(--hf-warning); }
.hf-dot.hf-tone-error { background-color: var(--hf-error); }
.hf-dot.hf-tone-neutral { background-color: var(--hf-neutral); }

/* Tag */

.hf-tag {
    height: 18px;
    margin-left: 6px;
    padding: 0 6px;
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--hf-border-subtle);
    font-size: 10px;
    color: var(--hf-text-muted);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

/* Callout */

.hf-callout {
    flex-direction: row;
    padding: 10px 12px;
    border-radius: 6px;
    border-left-width: 3px;
}

.hf-callout.hf-tone-info { border-left-color: var(--hf-info); }
.hf-callout.hf-tone-success { border-left-color: var(--hf-success); }
.hf-callout.hf-tone-warning { border-left-color: var(--hf-warning); }
.hf-callout.hf-tone-error { border-left-color: var(--hf-error); }
.hf-callout.hf-tone-neutral { border-left-color: var(--hf-neutral); }

.hf-callout__body {
    flex-grow: 1;
    flex-shrink: 1;
}

.hf-callout__title {
    -unity-font-style: bold;
    color: var(--hf-text-strong);
    white-space: normal;
    margin-bottom: 2px;
}

.hf-callout__message {
    white-space: normal;
    color: var(--hf-text);
}

.hf-callout__actions {
    flex-direction: row;
    margin-top: 8px;
}

/* Card and sections */

.hf-card {
    padding: 12px 14px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--hf-border-subtle);
    background-color: var(--hf-surface);
}

.hf-section {
    margin-top: 18px;
}

.hf-section__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.hf-section__hint {
    margin-bottom: 8px;
    white-space: normal;
    color: var(--hf-text-muted);
}

/* Key/value grid */

.hf-kv {
    flex-direction: row;
    align-items: center;
    min-height: 22px;
}

.hf-kv__key {
    width: 130px;
    flex-shrink: 0;
    color: var(--hf-text-muted);
}

.hf-kv__value {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.hf-kv__value > Label {
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Inputs */

.hf-root TextField > .unity-text-field__input,
.hf-root DropdownField > .unity-base-popup-field__input,
.hf-root IntegerField > .unity-integer-field__input {
    min-height: 22px;
    border-radius: 4px;
    border-color: var(--hf-border);
    background-color: var(--hf-input);
    color: var(--hf-text);
}

.hf-root TextField,
.hf-root DropdownField,
.hf-root IntegerField {
    margin: 0;
}

.hf-search {
    height: 24px;
    margin: 0;
}

.hf-search > .unity-text-field__input {
    padding-left: 22px;
    border-radius: 12px;
}

.hf-search__icon {
    position: absolute;
    left: 6px;
    top: 4px;
    width: 14px;
    height: 14px;
}

/* Divider */

.hf-divider {
    height: 1px;
    background-color: var(--hf-border-subtle);
}

/* Progress bar */

.hf-progress {
    height: 4px;
    border-radius: 2px;
    background-color: var(--hf-bar-track);
    overflow: hidden;
}

.hf-progress__fill {
    height: 100%;
    background-color: var(--hf-accent-hover);
}

/* Empty state */

.hf-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.hf-empty__icon {
    width: 48px;
    height: 48px;
    margin-bottom: 12px;
    opacity: 0.6;
}

.hf-empty__title {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--hf-text-strong);
    margin-bottom: 6px;
}

.hf-empty__message {
    max-width: 420px;
    white-space: normal;
    -unity-text-align: upper-center;
    color: var(--hf-text-muted);
    margin-bottom: 16px;
}
